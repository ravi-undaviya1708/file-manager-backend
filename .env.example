# ==============================================================================
# GetFileNova Backend Environment Configuration
# ==============================================================================

# MongoDB Connection
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-host>/
MONGODB_DB_NAME=file_manager

# CORS Allowed Origins (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://your-domain.com

# Environment (development, staging, production)
APP_ENV=development

# JWT Authentication
JWT_SECRET_KEY=your-secure-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google OAuth (Optional / Future Feature)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Backblaze B2 Storage Configuration
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET=your-b2-bucket-name
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com

# Cashfree Payments Configuration
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key
CASHFREE_ENV=sandbox
CASHFREE_MODE=test
CASHFREE_API_VERSION=2023-08-01

# Razorpay Payments Configuration (Optional)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Contact & Support Email
CONTACT_EMAIL=support@example.com

# Admin Email Notification Configuration (New User Registration Alerts)
ADMIN_NOTIFICATION_EMAIL=your-personal-gmail@gmail.com
ADMIN_NOTIFICATIONS_ENABLED=true

# SMTP Server Configuration (e.g. Gmail SMTP with App Password)
# For Gmail SSL: Host=smtp.gmail.com, Port=465
# For Gmail TLS: Host=smtp.gmail.com, Port=587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-sender-gmail@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-sender-gmail@gmail.com
SMTP_FROM_NAME=GetFileNova
