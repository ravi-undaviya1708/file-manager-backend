# ==============================================================================
# GetFileNova Backend Environment Configuration
# ==============================================================================

# MongoDB Connection
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-host>/
MONGODB_DB_NAME=file_manager

# CORS Allowed Origins (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://your-domain.com

# Environment (development, staging, production)
APP_ENV=development

# JWT Authentication
JWT_SECRET_KEY=your-secure-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google OAuth (Optional / Future Feature)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Backblaze B2 Storage Configuration
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET=your-b2-bucket-name
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com

# Cashfree Payments Configuration
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key
CASHFREE_WEBHOOK_SECRET=your-cashfree-webhook-secret
CASHFREE_ENV=SANDBOX
CASHFREE_SUBSCRIPTION_SERVICE=pg
CASHFREE_API_VERSION=2025-01-01
CASHFREE_MODE=

# Razorpay Payments Configuration (Optional)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Contact & Support Email
CONTACT_EMAIL=support@example.com

# Admin Email Notification Configuration (New User Registration Alerts)
ADMIN_NOTIFICATION_EMAIL=your-personal-gmail@gmail.com
ADMIN_NOTIFICATIONS_ENABLED=true

# SMTP Server Configuration (e.g. Gmail SMTP with App Password)
# For Gmail SSL: Host=smtp.gmail.com, Port=465
# For Gmail TLS: Host=smtp.gmail.com, Port=587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-sender-gmail@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-sender-gmail@gmail.com
SMTP_FROM_NAME=GetFileNova

# ==============================================================================
# Google Analytics 4 (GA4) Server-Side Data API Configuration (Admin Dashboard)
# ==============================================================================
# Numeric GA4 Property ID (e.g. 123456789 - DO NOT use G-XXXXXXXXXX Measurement ID)
GA4_PROPERTY_ID=123456789

# Google Cloud Service Account Email (e.g. name@project.iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com

# Google Cloud Service Account Private Key (Format: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----")
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"

# Optional: Path to Service Account JSON key file (Alternative to direct env vars)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

